{
  "expo": {
    "name": "Roamlet",
    "slug": "roamlet",
    "platforms": ["ios", "android"],
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "roamlet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.roamlet.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.roamlet.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "289dc43c-42ec-4f3b-9550-280275a34e55"
      }
    }
  }
}
